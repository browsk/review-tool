{
  "name": "review-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && tsx src/server/index.ts",
    "dev": "node esbuild.config.mjs --watch & tsx watch src/server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:perf": "playwright test --project=perf",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@terrastruct/d2": "0.1.33",
    "better-sqlite3": "^13.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "hono": "^4.13.19",
    "mdast-util-to-string": "^4.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
